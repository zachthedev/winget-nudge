<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- One winget release: the COM projection and the winrtact.dll pulled from the matching PowerShell module. -->
        <WinGetVersion>1.29.380</WinGetVersion>
        <WinGetModuleSha256>3469E5747EB6B100E51FED3F2057386B5BA60BC8955A6669B5C2EB562E316619</WinGetModuleSha256>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
        <PackageVersion Include="Microsoft.WindowsPackageManager.ComInterop" Version="$(WinGetVersion)" />
        <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.333" />
        <!-- Reads winget's pinning.db. -->
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <PackageVersion Include="System.CommandLine" Version="2.0.11" />
        <PackageVersion Include="Spectre.Console" Version="0.57.2" />
        <PackageVersion Include="Markdig" Version="1.3.2" />
        <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
        <PackageVersion Include="TaskScheduler" Version="2.12.2" />
        <PackageVersion Include="YamlDotNet" Version="18.1.0" />
        <!-- The installer's custom action. One WiX release with WixToolset.Sdk in the installer project. -->
        <PackageVersion Include="WixToolset.Dtf.CustomAction" Version="6.0.2" />
        <PackageVersion Include="WixToolset.Dtf.WindowsInstaller" Version="6.0.2" />
        <!-- The custom action's .NET Framework 4.7.2 reference assemblies, the same on every machine. -->
        <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
        <PackageVersion Include="xunit.v3" Version="4.0.0" />
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
        <!-- The TOML reader cake.cs uses for mise.toml and mise.lock. -->
        <PackageVersion Include="Tomlyn" Version="2.10.1" />
    </ItemGroup>
    <ItemGroup>
        <!--
            The analyzer behind the justification rule .editorconfig keeps on, in every C# project and
            cake.cs. A wixproj compiles no C#, so it takes none. The build row's canary fails a
            solution compile that loads no SA1404. cake.cs writes no log, so review of this line and
            cake.packages.lock.json keeps the analyzer there, and keeps this line the one place its
            version lives.
        -->
        <GlobalPackageReference
            Include="StyleCop.Analyzers"
            Version="1.2.0-beta.556"
            Condition="'$(MSBuildProjectExtension)' == '.csproj'"
        />
    </ItemGroup>
</Project>
