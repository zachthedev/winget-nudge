<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- One winget release: the COM projection and the winrtact.dll pulled from the matching PowerShell module. -->
        <WinGetVersion>1.29.290</WinGetVersion>
        <WinGetModuleSha256>726602001E6137EFFF66AA73C197C6AB6396AE2F9634D0ADAADA17EC5068EE46</WinGetModuleSha256>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
        <PackageVersion Include="Microsoft.WindowsPackageManager.ComInterop" Version="$(WinGetVersion)" />
        <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.333" />
        <!-- Reads winget's pinning.db. -->
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
        <PackageVersion Include="System.CommandLine" Version="2.0.11" />
        <PackageVersion Include="Spectre.Console" Version="0.57.2" />
        <PackageVersion Include="Markdig" Version="1.3.2" />
        <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
        <PackageVersion Include="TaskScheduler" Version="2.12.2" />
        <PackageVersion Include="YamlDotNet" Version="18.1.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.0" />
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    </ItemGroup>
</Project>
