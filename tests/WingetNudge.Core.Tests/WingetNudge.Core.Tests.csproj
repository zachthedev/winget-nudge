<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <RootNamespace>WingetNudge.Core.Tests</RootNamespace>
        <!-- LibraryImport generates unsafe marshaling code, and Support/Junction.cs declares its calls with it. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>
    <ItemGroup>
        <!--
            RequirementsTests reads from the nearest directory above this file that holds Directory.Packages.props.
            MSBuildThisFileDirectory is reserved, so no environment variable or global property moves that root.
        -->
        <AssemblyMetadata
            Include="RepositoryRoot"
            Value="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), Directory.Packages.props))"
        />
        <!-- The props file this build imported, which RequirementsTests holds to the one at the root. -->
        <AssemblyMetadata Include="DirectoryPackagesPropsPath" Value="$(DirectoryPackagesPropsPath)" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\WingetNudge.Core\WingetNudge.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- The custom action targets .NET Framework, so its decision logic compiles in here to run under the suite. -->
        <Compile Include="..\..\installer\CustomActions\RuntimeRequirement.cs" Link="Installer\RuntimeRequirement.cs" />
    </ItemGroup>
</Project>
