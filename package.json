{
  "name": "winget-nudge",
  "private": true,
  "type": "module",
  "description": "Commit message linting, markup formatting and git hooks for the Winget Nudge repository. The project itself is C#.",
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "lefthook"
  ],
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "prepare": "bun --no-env-file ./node_modules/lefthook/bin/index.js install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.14",
    "prettier": "3.9.8",
    "yaml": "2.9.1"
  }
}
