<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Winget objects are activated by CLSID, so the interop shim is not linked. -->
        <MicrosoftManagementDeployment-FactoryLinkage>none</MicrosoftManagementDeployment-FactoryLinkage>
        <RootNamespace>WingetNudge.Core</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" />
        <PackageReference Include="Microsoft.Windows.CsWin32">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="TaskScheduler" />
        <PackageReference Include="YamlDotNet" />
        <PackageReference Include="Humanizer.Core" />
    </ItemGroup>
    <ItemGroup>
        <!-- The suite drives single steps of a public operation, such as the replace inside JsonFile.Write. -->
        <InternalsVisibleTo Include="WingetNudge.Core.Tests" />
    </ItemGroup>
</Project>
