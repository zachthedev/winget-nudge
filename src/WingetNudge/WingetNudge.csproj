<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Winget objects are activated by CLSID, so the interop shim is not linked. -->
        <MicrosoftManagementDeployment-FactoryLinkage>none</MicrosoftManagementDeployment-FactoryLinkage>
        <OutputType>WinExe</OutputType>
        <RootNamespace>WingetNudge</RootNamespace>
        <AssemblyName>WingetNudge</AssemblyName>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <AssemblyTitle>Winget Nudge</AssemblyTitle>
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <!-- The self-contained runtime omits the notifications resource DLL; the installed runtime has it. -->
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <!-- The interop package copies its native shim only into projects that reference it directly. -->
        <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Spectre.Console" />
        <PackageReference Include="Markdig" />
        <PackageReference Include="Microsoft.Windows.CsWin32">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\WingetNudge.Core\WingetNudge.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
    winrtact.dll is winget's undocked reg-free WinRT hook. It ships only inside the WinGet
    PowerShell module, so the build pulls the module package matching $(WinGetVersion) from the
    PowerShell Gallery, checks its hash, and copies the x64 DLL to a fixed path in the cache
    directory, which a static item copies beside the executable. The cache directory carries the
    version, so a bump downloads and checks the new module rather than reusing the DLL an earlier
    version extracted. The module carries the DLL once for each PowerShell it supports: net48 for
    Windows PowerShell, and a net*-windows* folder for PowerShell 7, named for whatever framework
    the module builds against. The pattern takes the PowerShell 7 copy, and the build stops unless
    it matches exactly one file.
  -->
    <PropertyGroup>
        <WinGetModuleDirectory>$(BaseIntermediateOutputPath)psgallery\$(WinGetVersion)\</WinGetModuleDirectory>
        <WinGetModulePackage>$(WinGetModuleDirectory)Microsoft.WinGet.Client.$(WinGetVersion).nupkg</WinGetModulePackage>
        <WinRtActivationPattern>$(WinGetModuleDirectory)extracted\net*-windows*\SharedDependencies\x64\winrtact.dll</WinRtActivationPattern>
        <WinRtActivationDll>$(WinGetModuleDirectory)winrtact.dll</WinRtActivationDll>
    </PropertyGroup>
    <Target Name="FetchWinRtActivation" BeforeTargets="AssignTargetPaths" Condition="!Exists('$(WinRtActivationDll)')">
        <ItemGroup>
            <WinRtActivationMatch Include="$(WinRtActivationPattern)" />
        </ItemGroup>
        <DownloadFile
            Condition="'@(WinRtActivationMatch)' == '' and !Exists('$(WinGetModulePackage)')"
            SourceUrl="https://www.powershellgallery.com/api/v2/package/Microsoft.WinGet.Client/$(WinGetVersion)"
            DestinationFolder="$(WinGetModuleDirectory)"
            DestinationFileName="Microsoft.WinGet.Client.$(WinGetVersion).nupkg"
        />
        <GetFileHash Condition="'@(WinRtActivationMatch)' == ''" Files="$(WinGetModulePackage)" Algorithm="SHA256">
            <Output TaskParameter="Hash" PropertyName="WinGetModuleActualSha256" />
        </GetFileHash>
        <Error
            Condition="'@(WinRtActivationMatch)' == '' and '$(WinGetModuleActualSha256)' != '$(WinGetModuleSha256)'"
            Text="Microsoft.WinGet.Client $(WinGetVersion) hash mismatch: expected $(WinGetModuleSha256), got $(WinGetModuleActualSha256)."
        />
        <Unzip
            Condition="'@(WinRtActivationMatch)' == ''"
            SourceFiles="$(WinGetModulePackage)"
            DestinationFolder="$(WinGetModuleDirectory)extracted"
        />
        <ItemGroup Condition="'@(WinRtActivationMatch)' == ''">
            <WinRtActivationMatch Include="$(WinRtActivationPattern)" />
        </ItemGroup>
        <Error
            Condition="'@(WinRtActivationMatch)' == ''"
            Text="Microsoft.WinGet.Client $(WinGetVersion) holds no file matching $(WinRtActivationPattern), and the build copies exactly one."
        />
        <Error
            Condition="'@(WinRtActivationMatch->Count())' &gt; '1'"
            Text="Microsoft.WinGet.Client $(WinGetVersion) holds @(WinRtActivationMatch->Count()) files matching $(WinRtActivationPattern): @(WinRtActivationMatch, ', '). The build copies exactly one."
        />
        <Copy SourceFiles="@(WinRtActivationMatch)" DestinationFiles="$(WinRtActivationDll)" />
    </Target>
    <ItemGroup>
        <None
            Include="$(WinRtActivationDll)"
            Link="winrtact.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
    </ItemGroup>

    <!--
        The Windows App Runtime supplies the Windows ML natives, and the app calls none of them.
        Microsoft.WindowsAppSDK.ML removes them from the build output of a framework-dependent app. Its
        target runs after the SDK lists them for publish, so it misses the publish output the MSI
        carries. This target removes the same natives from publish.
    -->
    <Target Name="DropWindowsMLNativesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning' and '%(ResolvedFileToPublish.AssetType)' == 'native'"
            />
        </ItemGroup>
    </Target>

    <!--
        The Windows App Runtime framework package this build resolved, and the minimum version of it
        the bootstrapper requires at startup. The installer calls this target, so setup checks for the
        package the app will look for.
    -->
    <Target Name="GetWindowsAppRuntime" Returns="@(WindowsAppRuntime)">
        <ItemGroup>
            <WindowsAppRuntime
                Include="$(WinAppSDKPackageName)"
                Version="$(MicrosoftWindowsAppSDKFoundationAppXVersion)"
            />
        </ItemGroup>
    </Target>
</Project>
