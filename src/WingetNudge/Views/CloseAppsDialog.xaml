<ContentDialog
    x:Class="WingetNudge.Views.CloseAppsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Close applications"
    PrimaryButtonText="Close and continue"
    SecondaryButtonText="Skip package"
    DefaultButton="Primary"
>
    <StackPanel Spacing="12" MinWidth="400">
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" />
        <ListView x:Name="ProcessList" SelectionMode="None" MaxHeight="200" />
        <TextBlock
            x:Name="StatusText"
            TextWrapping="Wrap"
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.7"
            Text="These applications will be closed before upgrading and restarted afterwards."
        />
    </StackPanel>
</ContentDialog>
