<Window
    x:Class="WingetNudge.Views.PickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WingetNudge.Views"
>
    <Grid x:Name="Root">
        <Grid.Resources>
            <!--
            Placeholder fills. Both come from one token, the faint one by opacity, because the
            lighter control fills are near-white in the light theme and vanish on its backdrop.
            -->
            <Style x:Key="SkeletonBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            </Style>
            <Style x:Key="SkeletonFaintBarStyle" TargetType="Border" BasedOn="{StaticResource SkeletonBarStyle}">
                <Setter Property="Opacity" Value="0.55" />
            </Style>
            <!--
            Every focusable control in a row carries an x:Name. A rebuild replaces the row, and
            the name is how the window finds the same control in the replacement to hand focus
            back. The names repeat across the two row templates because each template is its own
            namescope.
            -->
            <DataTemplate x:Key="PackageRowTemplate" x:DataType="local:PickerItem">
                <Grid ColumnSpacing="8" Padding="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="SelectBox"
                        Grid.Column="0"
                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                        IsEnabled="{x:Bind CanSelect}"
                        ToolTipService.ToolTip="{x:Bind Caption, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Name}"
                        AutomationProperties.HelpText="{x:Bind Caption, Mode=OneWay}"
                        MinWidth="0"
                        Padding="0"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                    />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind InstalledName}"
                            Visibility="{x:Bind InstalledNameVisibility}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                        />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind InstalledVersion}" />
                            <FontIcon Glyph="&#xE72A;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind AvailableVersion}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind Age, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                        />
                        <!--
                        A note glyph is a private-use codepoint, so it needs the icon font a
                        FontIcon brings. A text run renders a missing-glyph box instead.
                        -->
                        <Grid ColumnSpacing="6" Visibility="{x:Bind NoteVisibility, Mode=OneWay}" Margin="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                Glyph="{x:Bind NoteGlyph, Mode=OneWay}"
                                Visibility="{x:Bind NoteGlyphVisibility, Mode=OneWay}"
                                FontSize="12"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Note, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                            />
                        </Grid>
                        <HyperlinkButton
                            x:Name="NotesLink"
                            Content="{x:Bind NotesLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind IsNotesEnabled, Mode=OneWay}"
                            Click="OnNotesClick"
                            Padding="0,2"
                        />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button
                            x:Name="RetryButton"
                            Click="{x:Bind Retry}"
                            Visibility="{x:Bind RetryVisibility}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Try this package again"
                            AutomationProperties.Name="Try this package again"
                        >
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="LogButton"
                            Click="{x:Bind OpenLog}"
                            Visibility="{x:Bind LogVisibility}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind LogPath}"
                            AutomationProperties.Name="Open the installer log"
                        >
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="SkipButton"
                            Click="{x:Bind ToggleSkip}"
                            Visibility="{x:Bind SkipVisibility}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind SkipToolTip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind SkipToolTip, Mode=OneWay}"
                        >
                            <FontIcon Glyph="&#xE894;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="MuteButton"
                            Click="{x:Bind ToggleMute}"
                            Visibility="{x:Bind MuteVisibility}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind MuteToolTip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind MuteToolTip, Mode=OneWay}"
                        >
                            <FontIcon Glyph="{x:Bind MuteGlyph, Mode=OneWay}" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="UnpinButton"
                            Click="{x:Bind CopyUnpinCommand}"
                            Visibility="{x:Bind UnpinVisibility}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind UnpinHint}"
                            AutomationProperties.Name="{x:Bind UnpinHint}"
                        >
                            <FontIcon Glyph="&#xE77A;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <!-- Laid out like a package row, so the two kinds line up in one list. -->
            <DataTemplate x:Key="ToolRowTemplate" x:DataType="local:ToolItem">
                <Grid ColumnSpacing="8" Padding="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="SelectBox"
                        Grid.Column="0"
                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Bind Name}"
                        MinWidth="0"
                        Padding="0"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                    />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind CurrentVersion}" />
                            <FontIcon Glyph="&#xE72A;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind LatestVersion}" />
                        </StackPanel>
                        <!--
                        A run cannot carry a background, so the command sits in its own chip
                        between the two halves of the caption. It stays selectable so it can be
                        copied by hand, and a command too long for the row trims with the whole
                        of it in the tooltip.
                        -->
                        <Grid ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MaxWidth="360" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="runs"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                            />
                            <Border Grid.Column="1" Style="{StaticResource InlineCodeChipStyle}">
                                <TextBlock
                                    Text="{x:Bind Command}"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    IsTextSelectionEnabled="True"
                                    ToolTipService.ToolTip="{x:Bind Command}"
                                />
                            </Border>
                            <TextBlock
                                Grid.Column="2"
                                Text="in its own window"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </StackPanel>
                    <Button
                        x:Name="RunButton"
                        Grid.Column="2"
                        Click="{x:Bind RunNow}"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Top"
                        ToolTipService.ToolTip="{x:Bind RunToolTip}"
                        AutomationProperties.Name="{x:Bind RunToolTip}"
                    >
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--
            One bar per line a real row draws, at the same pitch and the widths real content
            runs to. A placeholder that is shorter than what replaces it makes the whole list
            jump the moment the query answers.
            -->
            <DataTemplate x:Key="SkeletonRowTemplate" x:DataType="local:SkeletonRow">
                <Grid ColumnSpacing="8" Padding="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="20"
                        Height="20"
                        CornerRadius="4"
                        VerticalAlignment="Top"
                        Margin="0,1,0,0"
                        Style="{StaticResource SkeletonBarStyle}"
                    />
                    <StackPanel Grid.Column="1" Spacing="10">
                        <Border
                            Height="13"
                            Width="{x:Bind NameWidth}"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Style="{StaticResource SkeletonBarStyle}"
                        />
                        <Border
                            Height="10"
                            Width="{x:Bind SubtitleWidth}"
                            Visibility="{x:Bind SubtitleVisibility}"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Style="{StaticResource SkeletonFaintBarStyle}"
                        />
                        <Border
                            Height="13"
                            Width="{x:Bind VersionWidth}"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Style="{StaticResource SkeletonFaintBarStyle}"
                        />
                        <Border
                            Height="11"
                            Width="{x:Bind CaptionWidth}"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Style="{StaticResource SkeletonFaintBarStyle}"
                        />
                        <Border
                            Height="13"
                            Width="82"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Background="{ThemeResource AccentFillColorDisabledBrush}"
                        />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Top"
                        Margin="0,3,10,0"
                    >
                        <Border
                            Width="16"
                            Height="16"
                            CornerRadius="4"
                            Style="{StaticResource SkeletonFaintBarStyle}"
                        />
                        <Border
                            Width="16"
                            Height="16"
                            CornerRadius="4"
                            Style="{StaticResource SkeletonFaintBarStyle}"
                        />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <!-- ///// The list ///// -->

        <Grid x:Name="ListPage" Padding="24,12,24,24" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Updates" Style="{StaticResource TitleTextBlockStyle}" />
                    <Grid Height="16">
                        <TextBlock
                            x:Name="SummaryText"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        />
                        <Border
                            x:Name="SummarySkeleton"
                            Width="230"
                            Height="11"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource SkeletonFaintBarStyle}"
                        />
                    </Grid>
                </StackPanel>
                <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                    <AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="OnRefreshClick" />
                    <AppBarButton Icon="Setting" Label="Settings" Click="OnSettingsClick" />
                </CommandBar>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Sections" Margin="0,0,12,0" />
            </ScrollViewer>

            <Grid Grid.Row="1" x:Name="LoadingPanel">
                <StackPanel x:Name="SkeletonPanel" Margin="0,0,12,0" Opacity="0.7">
                    <StackPanel.Resources>
                        <Storyboard x:Name="SkeletonPulse" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation
                                Storyboard.TargetName="SkeletonPanel"
                                Storyboard.TargetProperty="Opacity"
                                From="0.5"
                                To="1"
                                Duration="0:0:0.9"
                            />
                        </Storyboard>
                    </StackPanel.Resources>
                    <!-- Section header: its select-all box, then the title. -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Height="32" Margin="0,8,0,0">
                        <Border
                            Width="20"
                            Height="20"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource SkeletonBarStyle}"
                        />
                        <Border
                            Width="72"
                            Height="13"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource SkeletonBarStyle}"
                        />
                    </StackPanel>
                    <ItemsControl x:Name="SkeletonRows" ItemTemplate="{StaticResource SkeletonRowTemplate}" />
                </StackPanel>
                <TextBlock
                    x:Name="LoadingText"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                />
            </Grid>

            <InfoBar Grid.Row="2" x:Name="MessageBar" IsOpen="False" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button
                    x:Name="UpdateButton"
                    Content="Update selected"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="OnUpdateClick"
                    MinWidth="140"
                />
                <Button x:Name="CloseButton" Content="Close" Click="OnCloseClick" MinWidth="100" />
            </StackPanel>
        </Grid>

        <!-- ///// Settings and release notes, shown in place of the list ///// -->

        <Grid x:Name="DetailPage" Visibility="Collapsed" Padding="24,12,24,24" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="BackButton"
                    Click="OnBackClick"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back"
                >
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock
                    x:Name="DetailTitle"
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                />
            </StackPanel>
            <ContentControl
                Grid.Row="1"
                x:Name="DetailHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
            />
        </Grid>
    </Grid>
</Window>
