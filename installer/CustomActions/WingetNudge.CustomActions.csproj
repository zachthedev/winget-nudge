<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Windows Installer hosts a managed custom action in the .NET Framework CLR, through DTF's SfxCA. -->
        <TargetFramework>net472</TargetFramework>
        <!-- net472 defaults to C# 7.3, and the rest of the repository is written in C# 14. -->
        <LangVersion>14</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <!-- DTF packs Content items into the .CA.dll beside the assembly, where SfxCA reads it. -->
        <Content Include="CustomAction.config" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="WixToolset.Dtf.CustomAction" />
        <PackageReference Include="WixToolset.Dtf.WindowsInstaller" />
        <!--
            The SDK references this package itself only on a machine without the 4.7.2 targeting pack,
            so the locked graph would depend on the machine. Referencing it always gives every machine
            the graph packages.lock.json records.
        -->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    </ItemGroup>
</Project>
