<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Windows Installer hosts a managed custom action in the .NET Framework CLR, through DTF's SfxCA. -->
        <TargetFramework>net472</TargetFramework>
        <!--
            net472 defaults to C# 7.3. latest follows the pinned SDK's compiler, which matches the
            language the rest of the repository compiles with while the SDK's major matches the target
            framework's.
        -->
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <!-- DTF packs Content items into the .CA.dll beside the assembly, where SfxCA reads it. -->
        <Content Include="CustomAction.config" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="WixToolset.Dtf.CustomAction" />
        <PackageReference Include="WixToolset.Dtf.WindowsInstaller" />
        <!--
            The SDK references this package itself only on a build host without the targeting pack for
            this project's framework, so the locked graph would depend on the host. Referencing it
            always gives every build the graph packages.lock.json records.
        -->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    </ItemGroup>
</Project>
