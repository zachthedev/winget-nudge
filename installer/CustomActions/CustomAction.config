<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!--
        SfxCA picks the CLR through the legacy activation API, which binds to .NET Framework 2.0 unless
        this file asks for 4.0. Without it the custom action never loads, and setup fails with 1603.
    -->
    <startup useLegacyV2RuntimeActivationPolicy="true">
        <supportedRuntime version="v4.0" />
    </startup>
</configuration>
