<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>WingetNudge</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <AppProject>..\src\WingetNudge\WingetNudge.csproj</AppProject>
    <CustomActionsProject>CustomActions\WingetNudge.CustomActions.csproj</CustomActionsProject>
    <!--
      The folder the package publishes the app to and harvests. The WiX SDK sets this project's own
      TargetFramework to native, so the folder's name carries no framework.
    -->
    <PublishDir>$(MSBuildThisFileDirectory)..\src\WingetNudge\bin\Release\$(RuntimeIdentifier)\publish\</PublishDir>
    <!-- Version and manufacturer come from Directory.Build.props so the MSI and the exe never disagree. -->
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(Version);Manufacturer=$(Authors)</DefineConstants>
    <!-- Per-user files under the profile have no registry key path; these ICEs assume a machine install. -->
    <!-- ICE61 objects to same-version upgrades, which are deliberate here. -->
    <!-- ICE60 wants a language on every versioned file; the native SQLite library has none. -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE60;ICE61;ICE64;ICE90;ICE91</SuppressIces>
    <SignToolPath Condition="'$(SignToolPath)' == ''">$(MSBuildProgramFiles32)\Windows Kits\10\bin\$(WindowsSdkBinVersion)\x64\signtool.exe</SignToolPath>
    <TimestampUrl Condition="'$(TimestampUrl)' == ''">http://timestamp.digicert.com</TimestampUrl>
    <Sign Condition="'$(SigningCertificateThumbprint)' != ''">true</Sign>
  </PropertyGroup>

  <!-- The package always carries a fresh Release publish of the app. -->
  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <!-- Start from an empty folder so a file removed from the app cannot linger into the package. -->
    <RemoveDir Directories="$(PublishDir)" />
    <MSBuild Projects="$(AppProject)" Targets="Publish" Properties="Configuration=Release;PublishDir=$(PublishDir)" />
  </Target>

  <!--
    The Windows App Runtime supplies the Windows ML natives, and DropWindowsMLNativesFromPublish in the app
    project keeps them out of publish. Nothing else fails when that target stops matching, so the package
    refuses them anywhere under the folder it harvests. The managed projection stays: deps.json lists it.
  -->
  <Target Name="RefuseWindowsMLNatives" AfterTargets="PublishApp">
    <ItemGroup>
      <WindowsMLNative
        Include="$(PublishDir)**\DirectML*.dll;$(PublishDir)**\onnxruntime*.dll;$(PublishDir)**\Microsoft.Windows.AI.MachineLearning*.dll"
        Exclude="$(PublishDir)**\*.Projection.dll"
      />
    </ItemGroup>
    <Error
      Condition="'@(WindowsMLNative)' != ''"
      Text="$(PublishDir) carries @(WindowsMLNative->'%(RecursiveDir)%(Filename)%(Extension)', ', '). The Windows App Runtime supplies the Windows ML natives, and DropWindowsMLNativesFromPublish in src\WingetNudge\WingetNudge.csproj did not remove them."
    />
  </Target>

  <!--
    Setup refuses without the Windows App Runtime the app's bootstrapper requires, so the package and
    minimum version come from the runtime package the app resolved, and a Microsoft.WindowsAppSDK bump
    moves them.
  -->
  <Target Name="DefineWindowsAppRuntime" BeforeTargets="BeforeBuild">
    <MSBuild Projects="$(AppProject)" Targets="GetWindowsAppRuntime" Properties="Configuration=Release">
      <Output TaskParameter="TargetOutputs" ItemName="WindowsAppRuntime" />
    </MSBuild>
    <PropertyGroup>
      <WindowsAppRuntimePackage>@(WindowsAppRuntime)</WindowsAppRuntimePackage>
      <WindowsAppRuntimeVersion>@(WindowsAppRuntime->'%(Version)')</WindowsAppRuntimeVersion>
    </PropertyGroup>
    <Error
      Condition="'$(WindowsAppRuntimePackage)' == '' or '$(WindowsAppRuntimeVersion)' == ''"
      Text="$(AppProject) resolved no Windows App Runtime package and version."
    />
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);WindowsAppRuntimePackage=$(WindowsAppRuntimePackage);WindowsAppRuntimeVersion=$(WindowsAppRuntimeVersion)</DefineConstants>
      <DefineConstants>$(DefineConstants);WindowsAppRuntimeDisplayVersion=$([System.Version]::Parse('$(WindowsAppRuntimeVersion)').ToString(3))</DefineConstants>
      <DefineConstants>$(DefineConstants);WindowsAppRuntimeMajor=$([System.Version]::Parse('$(WindowsAppRuntimeVersion)').Major)</DefineConstants>
    </PropertyGroup>
  </Target>

  <!-- The custom action runs in the installer's own process architecture, so its native host matches the package. -->
  <Target Name="BuildCustomActions" BeforeTargets="BeforeBuild">
    <MSBuild Projects="$(CustomActionsProject)" Targets="Build" Properties="Configuration=Release;Platform=$(InstallerPlatform)">
      <Output TaskParameter="TargetOutputs" ItemName="CustomActionsAssembly" />
    </MSBuild>
    <PropertyGroup>
      <CustomActionsDll>@(CustomActionsAssembly->'%(RootDir)%(Directory)%(Filename).CA%(Extension)')</CustomActionsDll>
      <DefineConstants>$(DefineConstants);CustomActionsDll=$(CustomActionsDll)</DefineConstants>
    </PropertyGroup>
  </Target>

  <!--
    Lists the files in the cabinet MakeSfxCA appends to a custom action DLL, read from the cabinet's own
    header. The cabinet ends the file, so it starts at the MSCF signature whose cbCabinet field reaches the
    end, and its CFFILE entries follow at coffFiles.
  -->
  <UsingTask
    TaskName="ReadAppendedCabinet"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll"
  >
    <ParameterGroup>
      <CabinetHost ParameterType="System.String" Required="true" />
      <FileNames ParameterType="System.String[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        byte[] data = System.IO.File.ReadAllBytes(CabinetHost);
        int cabinet = -1;
        for (int offset = 0; offset + 36 <= data.Length; offset++)
        {
            if (data[offset] == 0x4D && data[offset + 1] == 0x53 && data[offset + 2] == 0x43 && data[offset + 3] == 0x46
                && System.BitConverter.ToUInt32(data, offset + 8) == (uint)(data.Length - offset))
            {
                cabinet = offset;
                break;
            }
        }

        if (cabinet < 0)
        {
            Log.LogError("{0} ends in no cabinet.", CabinetHost);
            return false;
        }

        int count = System.BitConverter.ToUInt16(data, cabinet + 28);
        int entry = cabinet + (int)System.BitConverter.ToUInt32(data, cabinet + 16);
        System.Collections.Generic.List<string> names = new System.Collections.Generic.List<string>();
        for (int index = 0; index < count; index++)
        {
            // cbFile, uoffFolderStart, iFolder, date, time and attribs precede the null-terminated name.
            ushort attributes = System.BitConverter.ToUInt16(data, entry + 14);
            int nameStart = entry + 16;
            int nameEnd = System.Array.IndexOf(data, (byte)0, nameStart);
            System.Text.Encoding encoding = (attributes & 0x80) != 0 ? System.Text.Encoding.UTF8 : System.Text.Encoding.ASCII;
            names.Add(encoding.GetString(data, nameStart, nameEnd - nameStart));
            entry = nameEnd + 1;
        }

        FileNames = names.ToArray();
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!--
    SfxCA chooses the CLR from the CustomAction.config packed beside the custom action. Without it the
    custom action never loads, and every install ends in 1603 before the runtime check runs.
  -->
  <Target Name="RequireCustomActionConfig" AfterTargets="BuildCustomActions">
    <ReadAppendedCabinet CabinetHost="$(CustomActionsDll)">
      <Output TaskParameter="FileNames" ItemName="PackedCustomActionFile" />
    </ReadAppendedCabinet>
    <PropertyGroup>
      <PackedCustomActionFiles>;@(PackedCustomActionFile);</PackedCustomActionFiles>
    </PropertyGroup>
    <Message Text="$(CustomActionsDll) packs @(PackedCustomActionFile, ', ')." />
    <Error
      Condition="!$(PackedCustomActionFiles.Contains(';CustomAction.config;'))"
      Text="$(CustomActionsDll) packs @(PackedCustomActionFile, ', ') and no CustomAction.config. SfxCA reads that file to choose the CLR, and without it the custom action cannot load."
    />
  </Target>

  <!--
    Authenticode signing. The app's own binaries are signed before they are harvested, and the
    package after it is linked, so the UAC prompt names a publisher and any later change to the
    executable breaks the signature. Set SigningCertificateThumbprint in Directory.Signing.props.
  -->
  <Target Name="SignApp" AfterTargets="PublishApp" Condition="'$(Sign)' == 'true'">
    <Error Condition="!Exists('$(SignToolPath)')" Text="signtool.exe not found at $(SignToolPath); set SignToolPath." />
    <ItemGroup>
      <AppBinary Include="$(PublishDir)WingetNudge.exe;$(PublishDir)WingetNudge.dll;$(PublishDir)WingetNudge.Core.dll" />
    </ItemGroup>
    <Exec Command="&quot;$(SignToolPath)&quot; sign /sha1 $(SigningCertificateThumbprint) /fd SHA256 /tr $(TimestampUrl) /td SHA256 @(AppBinary->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>

  <Target Name="SignPackage" AfterTargets="Build" Condition="'$(Sign)' == 'true'">
    <Exec Command="&quot;$(SignToolPath)&quot; sign /sha1 $(SigningCertificateThumbprint) /fd SHA256 /tr $(TimestampUrl) /td SHA256 /d &quot;Winget Nudge&quot; &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
